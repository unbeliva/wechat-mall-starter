<view>
  <image src="{{product.images[0]}}" mode="aspectFill" style="width:100%;height:240px"></image>
  <view style="padding:12px">
    <view class="title">{{product.title}}</view>
    <view class="price">¥{{product.price/100}}</view>
    <view style="margin-top:8px">库存：{{product.stock}}</view>

    <block wx:for="{{product.skus}}" wx:key="skuId">
      <radio-group bindchange="onSkuChange" data-skuid="{{item.skuId}}">
        <label>
          <radio value="{{item.skuId}}" />{{item.attrs.join(' / ')}} - ¥{{item.price/100}} 库存:{{item.stock}}
        </label>
      </radio-group>
    </block>

    <view style="margin-top:12px">
      <button bindtap="addToCart">加入购物车</button>
      <button bindtap="goCart" class="button">查看购物车</button>
    </view>
  </view>
</view>
